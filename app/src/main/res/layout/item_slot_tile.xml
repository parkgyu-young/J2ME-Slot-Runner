<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tile_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_slot_tile"
    android:orientation="vertical"
    android:padding="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/tile_preview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_slot_preview"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tile_placeholder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/slot_not_started"
            android:textColor="@color/tile_preview_text"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@id/tile_preview"
            app:layout_constraintEnd_toEndOf="@id/tile_preview"
            app:layout_constraintStart_toStartOf="@id/tile_preview"
            app:layout_constraintTop_toTopOf="@id/tile_preview" />

        <TextView
            android:id="@+id/tile_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="@drawable/bg_slot_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="@color/tile_badge_text"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/tile_preview"
            app:layout_constraintTop_toTopOf="@id/tile_preview" />

        <TextView
            android:id="@+id/tile_proxy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="@drawable/bg_slot_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="@string/slot_proxy_badge"
            android:textColor="@color/tile_badge_text"
            android:textSize="11sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/tile_preview"
            app:layout_constraintTop_toTopOf="@id/tile_preview" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tile_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/tile_title"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tile_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/tile_status"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/tile_start"
            style="@style/SlotTileButton"
            android:contentDescription="@string/slot_cd_start"
            android:text="▶"
            tools:ignore="HardcodedText"
            xmlns:tools="http://schemas.android.com/tools" />

        <Button
            android:id="@+id/tile_stop"
            style="@style/SlotTileButton"
            android:contentDescription="@string/slot_cd_stop"
            android:text="■"
            tools:ignore="HardcodedText"
            xmlns:tools="http://schemas.android.com/tools" />

        <Button
            android:id="@+id/tile_menu"
            style="@style/SlotTileButton"
            android:contentDescription="@string/slot_cd_menu"
            android:text="☰"
            tools:ignore="HardcodedText"
            xmlns:tools="http://schemas.android.com/tools" />
    </LinearLayout>
</LinearLayout>
